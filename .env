# VoIP Management System Configuration
# Copy this content to your .env file

# Core Application
APP_NAME=VoIP Management System
VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Security (FIXED: Made secret key 32+ characters)
SECRET_KEY=your-very-secure-secret-key-for-development-32-chars-plus
CORS_ORIGINS=*

# Logging (FIXED: Uppercase log level)
LOG_LEVEL=DEBUG
LOG_DIRECTORY=logs

# PJSIP Configuration
PJSIP_ENABLED=true
PJSIP_CONF_PATH=local_test/pjsip.conf
PJSIP_TEMPLATES_DIR=local_test/templates
PJSIP_INCLUDES_DIR=local_test/includes/pjsip.d
PJSIP_BACKUP_DIR=local_test/backups
PJSIP_VALIDATE_CONFIGS=true
PJSIP_AUTO_BACKUP=true

# Asterisk Integration
ASTERISK_SOCKET=/var/run/asterisk/asterisk.ctl
ASTERISK_RELOAD_COMMAND=module reload res_pjsip.so

# Call Centre
DEFAULT_QUEUE_TIMEOUT=300
MAX_QUEUE_MEMBERS=50

# Provisioning
TFTP_SERVER=192.168.1.1
PROVISION_TEMPLATE_DIR=/var/lib/tftpboot/templates

# Features
FEATURE_CALL_RECORDING=true
FEATURE_REAL_TIME_STATS=true
FEATURE_AUTO_PROVISIONING=true
FEATURE_ADVANCED_ROUTING=true

# External Services (optional)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SENTRY_DSN=https://your-sentry-dsn-here