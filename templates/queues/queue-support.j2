; ============================================================================
; queue-support.j2 - Support/Help Desk Queue Template
; ============================================================================
[{{ queue_name }}]
; Support queue with priority handling and announcements
strategy={{ strategy | default('leastrecent') }}
musiconhold={{ musiconhold | default('default') }}
timeout={{ timeout | default(20) }}
retry={{ retry | default(3) }}
maxlen={{ maxlen | default(50) }}

; Enhanced announcements for support
announce-frequency={{ announce_frequency | default(30) }}
announce-holdtime={{ announce_holdtime | default('yes') }}
announce-position={{ announce_position | default('yes') }}
periodic-announce-frequency={{ periodic_announce_frequency | default(60) }}
{% if announce -%}
announce={{ announce }}
{% else -%}
announce=queue-support-intro
{% endif -%}
{% if periodic_announce -%}
periodic-announce={{ periodic_announce }}
{% else -%}
periodic-announce=queue-support-periodic
{% endif -%}

; Support-specific behavior
joinempty={{ joinempty | default('no') }}
leavewhenempty={{ leavewhenempty | default('yes') }}
ringinuse={{ ringinuse | default('no') }}
wrapuptime={{ wrapuptime | default(30) }}
autopause={{ autopause | default('yes') }}
autopausedelay={{ autopausedelay | default(10) }}
servicelevel={{ servicelevel | default(120) }}
weight={{ weight | default(10) }}

; Recording for quality assurance
monitor-type={{ monitor_type | default('MixMonitor') }}
monitor-format={{ monitor_format | default('wav') }}
monitor-join={{ monitor_join | default('yes') }}

{% if members -%}
; Support Team Members
{% for member in members -%}
member => {{ member }}
{% endfor -%}
{% endif -%}

