queue_management_script = '''
#!/bin/bash
# queue-manager.sh - Queue management helper script

# Add agent to queue
add_agent() {
    local queue=$1
    local agent=$2
    local penalty=${3:-0}
    
    curl -X POST "http://localhost:8000/api/v1/queues/$queue/members" \
         -G -d "member=$agent" -d "penalty=$penalty"
}

# Remove agent from queue  
remove_agent() {
    local queue=$1
    local agent=$2
    
    curl -X DELETE "http://localhost:8000/api/v1/queues/$queue/members/$agent"
}

# Pause/unpause agent (via Asterisk CLI)
pause_agent() {
    local queue=$1
    local agent=$2
    local reason=${3:-"Break"}
    
    asterisk -rx "queue pause member $agent queue $queue reason $reason"
}

unpause_agent() {
    local queue=$1  
    local agent=$2
    
    asterisk -rx "queue unpause member $agent queue $queue"
}

# Show queue status
show_queue() {
    local queue=${1:-"all"}
    
    if [ "$queue" = "all" ]; then
        asterisk -rx "queue show"
    else
        asterisk -rx "queue show $queue"
    fi
}

# Bulk agent management
bulk_add_agents() {
    local queue=$1
    shift
    local agents=("$@")
    
    for agent in "${agents[@]}"; do
        echo "Adding $agent to $queue..."
        add_agent "$queue" "$agent"
    done
}

# Emergency queue activation
activate_emergency() {
    echo "🚨 Activating emergency queue..."
    
    # Add all available agents to emergency queue
    bulk_add_agents "emergency" "PJSIP/1001" "PJSIP/1002" "PJSIP/1003"
    
    # Pause agents in other queues
    for queue in support-general support-vip sales; do
        for agent in PJSIP/1004 PJSIP/1005 PJSIP/1006; do
            pause_agent "$queue" "$agent" "Emergency"
        done
    done
    
    echo "✅ Emergency queue activated"
}

deactivate_emergency() {
    echo "🔄 Deactivating emergency queue..."
    
    # Remove agents from emergency queue
    for agent in PJSIP/1001 PJSIP/1002 PJSIP/1003; do
        remove_agent "emergency" "$agent"
    done
    
    # Unpause agents in other queues
    for queue in support-general support-vip sales; do
        for agent in PJSIP/1004 PJSIP/1005 PJSIP/1006; do
            unpause_agent "$queue" "$agent"
        done
    done
    
    echo "✅ Emergency queue deactivated"
}

# Usage examples
case "$1" in
    add)
        add_agent "$2" "$3" "$4"
        ;;
    remove)
        remove_agent "$2" "$3"
        ;;
    pause)
        pause_agent "$2" "$3" "$4"
        ;;
    unpause)
        unpause_agent "$2" "$3"
        ;;
    show)
        show_queue "$2"
        ;;
    emergency)
        activate_emergency
        ;;
    normal)
        deactivate_emergency
        ;;
    *)
        echo "Usage: $0 {add|remove|pause|unpause|show|emergency|normal}"
        echo "Examples:"
        echo "  $0 add support-general PJSIP/1001 5"
        echo "  $0 remove support-general PJSIP/1001"
        echo "  $0 pause support-general PJSIP/1001 'Lunch break'"
        echo "  $0 show support-general"
        echo "  $0 emergency"
        ;;
esac
'''

