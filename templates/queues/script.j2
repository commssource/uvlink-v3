queue_statistics_example = '''
# Queue Statistics and Monitoring

# 1. Real-time queue statistics via AMI
import asyncio
from asterisk.ami import AMIClient

async def get_queue_stats(queue_name):
    """Get real-time queue statistics"""
    client = AMIClient(host='localhost', port=5038, username='admin', password='secret')
    await client.login()
    
    # Get queue summary
    response = await client.send_action({
        'Action': 'QueueSummary',
        'Queue': queue_name
    })
    
    # Get queue status  
    status = await client.send_action({
        'Action': 'QueueStatus',
        'Queue': queue_name
    })
    
    await client.logoff()
    return {
        'summary': response,
        'status': status
    }

# 2. Queue performance metrics
def calculate_queue_metrics(queue_stats):
    """Calculate key performance indicators"""
    return {
        'service_level': queue_stats.get('service_level_perf', 0),
        'average_wait': queue_stats.get('avg_holdtime', 0),
        'calls_completed': queue_stats.get('completed', 0),
        'calls_abandoned': queue_stats.get('abandoned', 0),
        'abandonment_rate': queue_stats.get('abandoned', 0) / max(queue_stats.get('total_calls', 1), 1) * 100,
        'agent_utilization': queue_stats.get('agent_busy_time', 0) / queue_stats.get('agent_total_time', 1) * 100
    }

# 3. Dashboard data endpoint
@app.get("/api/v1/queues/dashboard")
async def queue_dashboard():
    """Get dashboard data for all queues"""
    queue_manager = get_queue_manager()
    queue_names = await queue_manager.list_queue_configs()
    
    dashboard_data = {
        'queues': [],
        'summary': {
            'total_queues': len(queue_names),
            'total_calls_waiting': 0,
            'total_agents_available': 0,
            'overall_service_level': 0
        }
    }
    
    for queue_name in queue_names:
        stats = await get_queue_stats(queue_name)
        metrics = calculate_queue_metrics(stats)
        
        dashboard_data['queues'].append({
            'name': queue_name,
            'calls_waiting': stats.get('calls_waiting', 0),
            'agents_available': stats.get('agents_available', 0),
            'longest_wait': stats.get('longest_wait', 0),
            'service_level': metrics['service_level'],
            'abandonment_rate': metrics['abandonment_rate']
        })
    
    return dashboard_data
'''